{
  "name": "mc-bot-egent-practice-2",
  "version": "0.1.0",
  "private": true,
  "description": "A persistent Japanese-speaking Minecraft AI companion",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc -p tsconfig.build.json",
    "build:dashboard": "vite build --config vite.config.ts",
    "dev": "tsx src/index.ts",
    "dev:dashboard": "vite --config vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "npm run typecheck:server && npm run typecheck:dashboard",
    "typecheck:server": "tsc --noEmit",
    "typecheck:dashboard": "tsc --noEmit -p tsconfig.dashboard.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx tests/e2e/live.ts",
    "test:e2e:dashboard": "tsx tests/e2e/dashboard-live.ts",
    "test:browser": "npm run build:dashboard && playwright test --config playwright.config.ts",
    "test:visual": "playwright test --config playwright.config.ts tests/browser/visual.spec.ts",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "openai": "7.5.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "vec3": "0.1.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
