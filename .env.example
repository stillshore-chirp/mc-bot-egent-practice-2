# このファイルには実値を入れない。`.env.local` を作成して実値を設定する。
# 必須値が空欄のままなら、起動と live E2E は設定エラーで停止する。

# Minecraft Java Edition server（必須）
MINECRAFT_HOST=
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=
# server の認証方式に合わせる。offline は server が明示的に許可する場合だけ使う。
MINECRAFT_AUTH=microsoft
# Bot が接続する server version。クライアント版ではない。
# 26.1 クライアントと 1.21.11 server の検証手順は docs/minecraft-26-1.md を参照。
MINECRAFT_VERSION=1.21.11

# 操作依頼を許可する唯一のプレイヤー（必須）
OWNER_USERNAME=

# OpenAI Responses API（必須）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# ローカル永続化と人格設定
DATABASE_PATH=data/companion.sqlite
PERSONA_PATH=config/persona.example.json

# 構造化ログ。debug / trace は実環境の会話や識別子を出力しない設定でだけ使用する。
LOG_LEVEL=info

# 切断復帰
CONNECT_TIMEOUT_MS=60000
MEMORY_CONTEXT_LIMIT=12
RECONNECT_ENABLED=true
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_DELAY_MS=5000

# Read-only management UI (loopback only).
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4310
# Optional local bearer authentication; minimum 32 characters. Never put this in a URL.
DASHBOARD_AUTH_TOKEN=
