# このファイルには実値を入れない。`.env.local` を作成して実値を設定する。
# 必須値が空欄のままなら、起動と live E2E は設定エラーで停止する。

# Minecraft Java Edition server（必須）
MINECRAFT_HOST=
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=
# server の認証方式に合わせる。offline は server が明示的に許可する場合だけ使う。
MINECRAFT_AUTH=microsoft
# Mineflayer が直接対応する server version を指定する。
MINECRAFT_VERSION=1.21.11

# 操作依頼を許可する唯一のプレイヤー（必須）
OWNER_USERNAME=

# OpenAI Responses API（必須）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ローカル永続化と人格設定
DATABASE_PATH=data/companion.sqlite
PERSONA_PATH=config/persona.example.json

# 読み取り専用トレースダッシュボード。既定はloopbackのみ。
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4310
DASHBOARD_STATIC_DIR=dashboard/dist
# loopback外へbindする場合は32文字以上のtokenとHTTPS reverse proxyを必須にする。
DASHBOARD_AUTH_TOKEN=
TRACE_RETENTION_DAYS=30
TRACE_MAX_RUNS=500

# 構造化ログ。debug / trace は実環境の会話や識別子を出力しない設定でだけ使用する。
LOG_LEVEL=info

# 行動・安全上限
MAX_MOVE_DISTANCE=128
MAX_GATHER_COUNT=64
TASK_TIMEOUT_MS=900000
SKILL_RETRY_LIMIT=2
FOLLOW_DISTANCE=3
HUNGER_THRESHOLD=14

# 切断復帰
RECONNECT_ENABLED=true
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_DELAY_MS=5000

# 一度の deliberation に渡す記憶 record の上限
MEMORY_CONTEXT_LIMIT=12

# live E2E専用。安全なtest worldと全試験操作の許可を確認したrunでだけtrueにする。
LIVE_E2E_CONFIRMED=false
